# =============================================================
# AI Advertising Agent - Environment Variables Template
# Copy this file to .env and fill in your actual credentials
# =============================================================

# Claude AI (required)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ---------------------------------------------------------------
# Facebook / Meta
# Get credentials at: https://developers.facebook.com/
# ---------------------------------------------------------------
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_ACCESS_TOKEN=your_facebook_page_access_token
FACEBOOK_PAGE_ID=your_facebook_page_id

# ---------------------------------------------------------------
# Instagram (via Meta Graph API)
# Get credentials at: https://developers.facebook.com/
# ---------------------------------------------------------------
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token
INSTAGRAM_ACCOUNT_ID=your_instagram_business_account_id

# ---------------------------------------------------------------
# Twitter / X
# Get credentials at: https://developer.twitter.com/
# ---------------------------------------------------------------
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_ACCESS_TOKEN=your_twitter_access_token
TWITTER_ACCESS_SECRET=your_twitter_access_token_secret
TWITTER_BEARER_TOKEN=your_twitter_bearer_token

# ---------------------------------------------------------------
# LinkedIn
# Get credentials at: https://www.linkedin.com/developers/
# ---------------------------------------------------------------
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token

# ---------------------------------------------------------------
# YouTube / Google
# Get credentials at: https://console.developers.google.com/
# ---------------------------------------------------------------
YOUTUBE_API_KEY=your_youtube_api_key
YOUTUBE_CLIENT_ID=your_youtube_client_id
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret
YOUTUBE_REFRESH_TOKEN=your_youtube_refresh_token

# ---------------------------------------------------------------
# TikTok
# Get credentials at: https://developers.tiktok.com/
# ---------------------------------------------------------------
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret
TIKTOK_ACCESS_TOKEN=your_tiktok_access_token

# ---------------------------------------------------------------
# Google Ads
# Get credentials at: https://developers.google.com/google-ads/
# ---------------------------------------------------------------
GOOGLE_ADS_DEVELOPER_TOKEN=your_google_ads_developer_token
GOOGLE_ADS_CLIENT_ID=your_google_ads_client_id
GOOGLE_ADS_CLIENT_SECRET=your_google_ads_client_secret
GOOGLE_ADS_REFRESH_TOKEN=your_google_ads_refresh_token
GOOGLE_ADS_CUSTOMER_ID=your_google_ads_customer_id

# ---------------------------------------------------------------
# Application Settings
# ---------------------------------------------------------------
DEMO_MODE=true           # Set to false to use real API calls
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
